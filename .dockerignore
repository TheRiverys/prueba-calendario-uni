# =====================================================
# .dockerignore para Calendario Entregas UNI
# Optimiza el build de Docker excluyendo archivos innecesarios
# =====================================================

# Dependencias y archivos de desarrollo
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn

# Archivos de configuración de desarrollo
.env.local
.env.development.local
.env.test.local
.env.production.local

# Archivos de sistema
.DS_Store
Thumbs.db

# Archivos de Git (ya que estamos en Docker)
.git/
.gitignore
.gitattributes

# Archivos de GitHub (no necesarios en producción)
.github/

# Archivos de CI/CD (no necesarios en producción)
.husky/

# Carpeta --version (archivos de Git internos)
--version/

# Archivos de Cursor (IDE)
.cursor/

# Archivos de desarrollo de Vite
.vite/
coverage/

# Archivos de testing
**/*.test.*
**/*.spec.*
**/test/
**/tests/
**/__tests__/
**/coverage/

# Archivos de documentación (no necesarios en producción)
*.md
docs/
CHANGELOG.md
README.md

# Archivos de IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Archivos de logs
*.log
logs/

# Archivos temporales
tmp/
temp/

# Archivos de cache
.cache/
.parcel-cache/

# Archivos de análisis de métricas
**/dist/stats.html

# Archivos de análisis de cobertura
coverage/
.nyc_output/

# Archivos de análisis de bundle
**/dist/report.html

# Solo incluir archivos necesarios para producción
# El Dockerfile ya maneja la instalación de dependencias
